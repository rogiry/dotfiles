#!/bin/sh
# ccstatusline 의 custom-command 위젯용.
#
# 현재 브랜치가 원격(upstream)과 어떤 관계인지 한 글자로 요약한다.
#
#   ✓      원격과 동일 (푸시할 것도, 받을 것도 없음)
#   ↑2     로컬이 2커밋 앞섬 → 푸시 필요
#   ↓3     원격이 3커밋 앞섬 → 풀 필요
#   ↑2↓3   양쪽이 갈라짐
#   ⚠      upstream 이 설정되지 않은 브랜치 (git push -u 필요)
#   (없음)  git 저장소가 아님
#
# 주의: 이 스크립트의 cwd 는 ccstatusline 프로세스의 cwd 이지
#       상태줄이 표시 중인 디렉토리가 아니다. 반드시 stdin JSON 에서 읽는다.
#
# 작업 트리의 변경 여부(✓/✗)는 여기서 다루지 않는다.
# 그건 상태줄의 +N-M 과 S: M: ?: 위젯이 이미 보여준다.

set -u

# stdin 의 Claude Code statusline JSON 에서 디렉토리를 꺼낸다.
json=$(cat)
dir=$(printf '%s' "$json" | sed -n 's/.*"current_dir"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
[ -n "$dir" ] || dir=$(printf '%s' "$json" | sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
[ -n "$dir" ] || exit 0
[ -d "$dir" ] || exit 0

git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

# upstream 이 없으면 비교 대상이 없다.
counts=$(git -C "$dir" rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null) || {
    printf '⚠'
    exit 0
}
[ -n "$counts" ] || { printf '⚠'; exit 0; }

# "behind<TAB>ahead" 형식
behind=$(printf '%s' "$counts" | awk '{print $1}')
ahead=$(printf '%s' "$counts" | awk '{print $2}')

if [ "$ahead" = "0" ] && [ "$behind" = "0" ]; then
    printf '✓'
else
    [ "$ahead" = "0" ]  || printf '↑%s' "$ahead"
    [ "$behind" = "0" ] || printf '↓%s' "$behind"
fi
